# Copy to .env and adjust. All settings are optional; sane defaults are used for local dev.

# SQLAlchemy database URL.
# Local (no Postgres needed): sqlite+pysqlite:///./mki.db
# Docker / Postgres:          postgresql+psycopg://mki:mki@localhost:5432/mki
MKI_DATABASE_URL=sqlite+pysqlite:///./mki.db

# --- LLM via OpenRouter (RFC-0002) ---
# When the key is empty, extraction AND verification run in deterministic stub
# mode (no external calls), so tests and local dev work offline.
MKI_OPENROUTER_API_KEY=
MKI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# One model extracts; a different-family ensemble verifies (comma-separated slugs).
MKI_EXTRACTOR_MODEL=openai/gpt-5.1
MKI_VERIFIER_MODELS=anthropic/claude-sonnet-4.5,google/gemini-2.5-pro,openai/gpt-4o

# Publish only when all models pass and mean confidence >= threshold.
MKI_VERIFY_THRESHOLD=0.75
